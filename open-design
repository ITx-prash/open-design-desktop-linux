                    if cleaned:
                        log_buf.insert(log_buf.get_end_iter(), f"> {cleaned}\n")
                        log_view.scroll_to_iter(log_buf.get_end_iter(), 0.0, False, 0.0, 0.0)
                return False

            def update_ui(pct, msg, step_txt):
                if not win.get_visible():
                    return False
                pbar.set_fraction(pct)
                slbl.set_text(msg)
                step_lbl.set_text(step_txt)
                return False

            def on_done():
                active_update_cancel["fn"] = None
                pbar.stop()
                if not win.get_visible():
                    return False
                _prepare_centered_stage("✓", "success-badge-circle")

                tbox = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=4)
                tbox.set_halign(Gtk.Align.CENTER)
                tbox.set_margin_top(CENTERED_TITLE_TOP_MARGIN)
                t = Gtk.Label(label="Update Complete")
                t.add_css_class("dialog-title")
                tbox.append(t)

                s = Gtk.Label(label=f"Open Design is now updated to {clean_lat}.")
                s.add_css_class("dialog-subtitle")
                tbox.append(s)
                content_area.append(tbox)

                nbtn = Gtk.Button(label="View release notes on GitHub ↗")
                nbtn.add_css_class("notes-link")
                nbtn.set_halign(Gtk.Align.CENTER)
                nbtn.set_margin_top(10)
                nbtn.connect("clicked", lambda b: open_release_notes(b, lat_v))
                content_area.append(nbtn)

                close_btn = Gtk.Button(label="Close")
                close_btn.add_css_class("btn-secondary")
                close_btn.connect("clicked", lambda b: win.close())
                action_bar.append(close_btn)

                launch_btn = Gtk.Button(label="Launch")
                launch_btn.add_css_class("btn-primary")
                launch_btn.add_css_class("suggested-action")

                def on_launch(b):
                    result["action"] = "launch"
                    win.close()

                launch_btn.connect("clicked", on_launch)
                action_bar.append(launch_btn)
                if hasattr(win, "set_default_widget"):
                    win.set_default_widget(launch_btn)
                return False

            def on_fail(step_name):
                active_update_cancel["fn"] = None
                pbar.stop()
                if not win.get_visible():
                    return False
                if updating_state["close_after"]:
                    win.close()
                    return False
                if step_name == "cancelled by user":
                    title.set_markup("<b>Update Cancelled</b>")
                    subtitle.set_text("Update cancelled by user.")
                else:
                    title.set_markup("<b>Update Failed</b>")
                    subtitle.set_text(f"An error occurred during {step_name}.")
                subtitle.add_css_class("error-badge")
                fail_badge.set_visible(True)
                prog_box.set_visible(False)
                details_header.set_margin_top(6)
                cbtn.set_label("Close")
                cbtn.set_sensitive(True)
                if hasattr(win, "set_default_widget"):
                    win.set_default_widget(cbtn)
                set_details_expanded(True)
                return False

            def run_step(cmd, pct, status_msg, step_txt, fail_label, env=None, mutates_build=True):
                """Run a single update step; return True on success, False on failure or cancel."""
                if updating_state["canceled"]:
                    return False
                GLib.idle_add(update_ui, pct, status_msg, step_txt)
                try:
                    proc = subprocess.Popen(
                        cmd,
                        cwd=cfg["repo"],
                        env=env,
                        stdin=subprocess.DEVNULL,
                        stdout=subprocess.PIPE,
                        stderr=subprocess.STDOUT,
                        text=True,
                        encoding="utf-8",
                        errors="replace",
                        start_new_session=True,
                    )
                except OSError as e:
                    GLib.idle_add(append_log, f"Failed to execute {cmd[0]}: {e}")
                    if mutates_build:
                        rollback_to_original()
                    GLib.idle_add(on_fail, fail_label)
                    return False
                updating_state["proc"] = proc
                if proc.stdout:
                    for line in proc.stdout:
                        GLib.idle_add(append_log, line)
                rc = proc.wait()
                updating_state["proc"] = None
                if updating_state["canceled"]:
                    return False
                if rc != 0:
                    if mutates_build:
                        rollback_to_original()
                    GLib.idle_add(on_fail, fail_label)
                    return False
                return True

            def worker():
                active_lock_file, active_lock_path = get_active_update_lock()
                if active_lock_file is None:
                    GLib.idle_add(on_fail, "concurrent update lock")
                    return
                try:
                    legacy_stamp = os.path.join(cfg["repo"], ".open-design-build-stamp")
                    if os.path.exists(legacy_stamp):
                        os.unlink(legacy_stamp)
                except OSError:
                    pass
                try:
                    build_env = os.environ.copy()
                    build_env["NODE_OPTIONS"] = "--max-old-space-size=4096"
                    raw_ver = clean_lat.lstrip("v")
                    if raw_ver and raw_ver != "unknown":
                        build_env["OD_APP_VERSION"] = raw_ver
                        build_env["OD_RELEASE_CHANNEL"] = "stable"
                    build_env["OD_WEB_OUTPUT_MODE"] = "server"
                    build_env.setdefault("ONNXRUNTIME_NODE_INSTALL_CUDA", "skip")
                    build_env.setdefault("ELECTRON_SKIP_BINARY_DOWNLOAD", "1")
                    git_env = os.environ.copy()
                    git_env["GIT_TERMINAL_PROMPT"] = "0"

                    # Guard against overwriting uncommitted or untracked local files in the repository
                    try:
                        st_res = subprocess.run(
                            ["git", "status", "--porcelain"],
                            cwd=cfg["repo"],
                            capture_output=True,
                            text=True,
                            timeout=10,
                        )
                        if st_res.returncode == 0 and st_res.stdout.strip():
                            GLib.idle_add(
                                append_log,
                                f"Uncommitted or untracked local files detected in {cfg['repo']}. Please commit, stash, or remove them before updating.",
                            )
                            GLib.idle_add(on_fail, "local changes check")
                            return
                    except Exception:
                        pass

                    if updating_state["canceled"]:
                        GLib.idle_add(on_fail, "cancelled by user")
                        return

                    GLib.idle_add(update_ui, 0.15, "Stopping background services...", "Step 1 of 5")
                    stop_services(cfg)
                    if (
                        get_repo_pids(cfg["repo"])
                        or get_pwa_browser_pids(cfg["pwa_dir"])
                        or is_server_running(cfg["host"], cfg["port"])
                    ):
                        GLib.idle_add(
                            append_log,
                            f"Could not stop running Open Design services or free port {cfg['port']}.",
                        )
                        GLib.idle_add(on_fail, "stopping services")
                        return

                    if updating_state["canceled"]:
                        GLib.idle_add(on_fail, "cancelled by user")
                        return

                    # Ensure target tag objects are fetched locally before marking build-stamp as pending,
                    # so a network failure or cancel during git fetch leaves the existing build runnable.
                    local_tag_check = subprocess.run(
                        ["git", "rev-parse", "-q", "--verify", f"refs/tags/{lat_v}"],
                        cwd=cfg["repo"],
                        capture_output=True,
                        text=True,
                    )
                    if local_tag_check.returncode != 0:
                        if not run_step(
                            ["git", "fetch", "--depth=1", "origin", f"refs/tags/{lat_v}:refs/tags/{lat_v}", "--force", "-q"],
                            0.28,
                            f"Downloading {clean_lat}...",
                            "Step 2 of 5",
                            "git fetch",
                            env=git_env,
                            mutates_build=False,
                        ):
                            if updating_state["canceled"]:
                                GLib.idle_add(on_fail, "cancelled by user")
                            return

                    if updating_state["canceled"]:
                        GLib.idle_add(on_fail, "cancelled by user")
                        return

                    try:
                        os.makedirs(os.path.dirname(stamp_path), mode=0o700, exist_ok=True)
                        with open(stamp_path, "w", encoding="utf-8") as sf:
                            sf.write(f"pending:{lat_v}\n")
                    except OSError:
                        pass

                    steps = [
                        (
                            ["git", "checkout", "-f", lat_v, "--quiet"],
                            0.35,
                            f"Checking out {clean_lat}...",
                            "Step 2 of 5",
                            "git checkout",
                            git_env,
                        ),
                        (
                            ["pnpm", "install", "--config.engine-strict=false", "--frozen-lockfile", "--prefer-offline"],
                            0.60,
                            "Installing dependencies...",
                            "Step 3 of 5",
                            "dependency installation",
                            build_env,
                        ),
                        (
                            ["pnpm", "--filter", "@open-design/daemon", "build"],
                            0.75,
                            "Building daemon service...",
                            "Step 4 of 5",
                            "daemon build",
                            build_env,
                        ),
                        (
                            ["pnpm", "--filter", "@open-design/web", "build"],
                            0.90,
                            "Building web interface...",
                            "Step 5 of 5",
                            "web build",
                            build_env,
                        ),
                    ]

                    for cmd, pct, status_msg, step_txt, fail_label, step_env in steps:
                        if not run_step(cmd, pct, status_msg, step_txt, fail_label, env=step_env):
                            if updating_state["canceled"]:
                                rollback_to_original()
                                GLib.idle_add(on_fail, "cancelled by user")
                            return

                    if updating_state["canceled"]:
                        rollback_to_original()
                        GLib.idle_add(on_fail, "cancelled by user")
                    else:
                        try:
                            with open(stamp_path, "w", encoding="utf-8") as sf:
                                sf.write(f"{lat_v}\n")
                        except OSError:
                            pass
                        GLib.idle_add(on_done)
                except Exception as exc:
                    rollback_to_original()
                    GLib.idle_add(append_log, f"Unexpected error: {exc}")
                    GLib.idle_add(on_fail, "update process")
                finally:
                    release_update_lock(active_lock_file, active_lock_path)

            wt = threading.Thread(target=worker, daemon=False)
            result["worker_thread"] = wt
            wt.start()

        def check_tags():
            git_env = os.environ.copy()
            git_env["GIT_TERMINAL_PROMPT"] = "0"

            # Query remote release tags via lightweight ls-remote (<2 KB transfer, no packfile download)
            # with automatic retry and fallback to git fetch --tags
            all_tags = []
            last_err_timeout = False

            for attempt in range(2):
                try:
                    ls_res = subprocess.run(
                        ["git", "ls-remote", "--tags", "--refs", "origin", "refs/tags/open-design-v*"],
                        cwd=cfg["repo"],
                        env=git_env,
                        timeout=20,
                        capture_output=True,
                        text=True,
                    )
                    if ls_res.returncode == 0:
                        for line in ls_res.stdout.splitlines():
                            if "refs/tags/" in line:
                                t = line.split("refs/tags/", 1)[-1].strip()
                                if t.startswith("open-design-v"):
                                    all_tags.append(t)
                        break
                    last_err_timeout = False
                except subprocess.TimeoutExpired:
                    last_err_timeout = True
                except Exception:
                    last_err_timeout = False
                if attempt == 0:
                    time.sleep(0.5)

            if not all_tags:
                try:
                    res = subprocess.run(
                        ["git", "fetch", "--tags", "--force", "-q"],
                        cwd=cfg["repo"],
                        env=git_env,
                        timeout=25,
                        capture_output=True,
                        text=True,
                    )
                    if res.returncode != 0:
                        GLib.idle_add(
                            show_error,
                            "Make sure you're connected to the internet,\nthen try again.",
                        )
                        return
                except subprocess.TimeoutExpired:
                    GLib.idle_add(
                        show_error,
                        "The connection to GitHub timed out.\nPlease try again in a moment.",
                    )
                    return
                except Exception:
                    GLib.idle_add(
                        show_error,
                        "Make sure you're connected to the internet,\nthen try again.",
                    )
                    return

                tags_res = subprocess.run(
                    ["git", "tag", "-l", "open-design-v*"],
                    cwd=cfg["repo"],
                    capture_output=True,
                    text=True,
                )
                all_tags = [t.strip() for t in tags_res.stdout.splitlines() if t.strip()]

            if not all_tags:
                if last_err_timeout:
                    GLib.idle_add(
                        show_error,
                        "The connection to GitHub timed out.\nPlease try again in a moment.",
                    )
                else:
                    GLib.idle_add(
                        show_error,
                        "No release tags were found\nin the upstream repository.",
                    )
                return

            # Prefer strict semver stable tags; verify against published GitHub Releases when reachable
            tags = [t for t in all_tags if re.match(r"^open-design-v\d+\.\d+\.\d+$", t)]

            api_override = os.environ.get("OPEN_DESIGN_RELEASES_API", "").strip()
            origin_url = ""
            try:
                orig_res = subprocess.run(
                    ["git", "remote", "get-url", "origin"],
                    cwd=cfg["repo"],
                    capture_output=True,
                    text=True,
                    timeout=3,
                )
                origin_url = orig_res.stdout.strip()
            except Exception:
                pass

            if api_override or "nexu-io/open-design" in origin_url:
                rel_url = api_override or "https://api.github.com/repos/nexu-io/open-design/releases?per_page=30"
                try:
                    req = urllib.request.Request(
                        rel_url,
                        headers={"Accept": "application/vnd.github+json", "User-Agent": "open-design-desktop-linux"},
                    )
                    with urllib.request.urlopen(req, timeout=6) as resp:
                        rel_data = json.loads(resp.read().decode("utf-8", errors="replace"))
                    if isinstance(rel_data, dict):
                        rel_data = [rel_data]
                    published = {
                        r.get("tag_name", "").strip()
                        for r in rel_data
                        if isinstance(r, dict) and not r.get("draft") and not r.get("prerelease") and r.get("tag_name")
                    }
                    verified_tags = [t for t in tags if t in published]
                    if verified_tags or api_override:
                        tags = verified_tags
                except Exception:
                    if api_override:
                        tags = []

            if not tags:
                GLib.idle_add(
                    show_error,
                    "No published stable releases were found\nin the upstream repository.",
                )
                return

            tags.sort(key=parse_ver)
            latest_tag = tags[-1]

            cur_res = subprocess.run(
                ["git", "describe", "--tags", "--exact-match", "--match", "open-design-v*"],
                cwd=cfg["repo"],
                capture_output=True,
                text=True,
            )
            current_tag = cur_res.stdout.strip() if cur_res.returncode == 0 else ""

            cur_ver = get_installed_version(cfg["repo"], current_tag=current_tag)
            orig_ref = get_current_git_ref(cfg["repo"]) or current_tag

            has_pending_build = False
            stamp_check_path = os.path.expanduser("~/.config/open-design/build-stamp")
            if os.path.isfile(stamp_check_path):
                try:
                    with open(stamp_check_path, "r", encoding="utf-8", errors="ignore") as scf:
                        has_pending_build = scf.read().strip().startswith("pending:")
                except OSError:
                    pass

            is_latest = (not has_pending_build) and (
                (current_tag == latest_tag)
                or (cur_ver != "unknown" and parse_ver(cur_ver) >= parse_ver(latest_tag))
            )
            if is_latest:
                GLib.idle_add(show_uptodate, latest_tag)
            else:
                GLib.idle_add(show_prompt, clean_ver_str(cur_ver), latest_tag, orig_ref)

        show_checking()
        threading.Thread(target=check_tags, daemon=True).start()

    app.connect("activate", on_activate)
    app.run([])

    if result["worker_thread"] is not None and result["worker_thread"].is_alive():
        result["worker_thread"].join(timeout=5.0)

    release_update_lock(lock_file, lock_path)

    if result["action"] == "launch":
        cmd_start()


def main():
    raw_args = sys.argv[1:]
    args = [a for a in raw_args if a not in ("-q", "--quiet")]
    quiet = len(args) != len(raw_args)
    if len(args) > 1:
        print(f"Error: Unexpected argument '{args[1]}'.", file=sys.stderr)
        print("Usage: open-design [--stop | --update | --version | --help]", file=sys.stderr)
        sys.exit(2)
    action = args[0] if args else "start"
    if quiet and action not in ("--stop", "stop", "--start", "start"):
        print(f"Error: '--quiet' cannot be combined with '{action}'.", file=sys.stderr)
        print("Usage: open-design [--stop | --update | --version | --help]", file=sys.stderr)
        sys.exit(2)
    if action in ("--start", "start"):
        cmd_start()
    elif action in ("--stop", "stop"):
        cmd_stop(quiet=quiet)
    elif action in ("--update", "update"):
        cmd_update()
    elif action in ("--version", "-v"):
        cfg = load_config()
        print(f"Open Design Desktop ({clean_ver_str(get_installed_version(cfg['repo']))})")
    elif action in ("--help", "-h"):
        print("Open Design Desktop")
        print("Usage: open-design [--stop | --update | --version | --help]")
    else:
        print(f"Error: Unknown option '{action}'.", file=sys.stderr)
        print("Usage: open-design [--stop | --update | --version | --help]", file=sys.stderr)
        sys.exit(2)


if __name__ == "__main__":
    main()
