    class ShimmerProgressBar(Gtk.DrawingArea):
        """
        Custom hardware-synchronized progress bar with a soft specular highlight sheen
        traveling left-to-right across the active progress and smooth easing.
        """
        def __init__(self):
            super().__init__()
            self.set_content_height(4)
            self.set_hexpand(True)
            self.current_fraction = 0.05
            self.target_fraction = 0.05
            self.shimmer_offset = 0.0
            self._stopped = False
            self.set_draw_func(self.draw)
            self.add_tick_callback(self.on_tick)

        def set_fraction(self, frac):
            self.target_fraction = max(0.0, min(1.0, frac))
            self.queue_draw()

        def stop(self):
            """Stop the frame-clock tick callback to avoid unnecessary GPU wakeups."""
            self._stopped = True

        def on_tick(self, widget, frame_clock):
            if self._stopped:
                return False
            if not self.get_visible() or not self.get_mapped():
                return True

            # 1. Smooth interpolation toward target fraction
            diff = self.target_fraction - self.current_fraction
            if abs(diff) > 0.0005:
                self.current_fraction += diff * 0.10

            # 2. Specular sheen traveling sweep across completed portion
            self.shimmer_offset += 0.016
            if self.shimmer_offset > 1.4:
                self.shimmer_offset = -0.4

            self.queue_draw()
            return True

        def draw(self, area, cr, width, height):
            r = height / 2.0

            # Background trough (#27272a)
            cr.arc(r, r, r, math.pi / 2, 3 * math.pi / 2)
            cr.arc(width - r, r, r, -math.pi / 2, math.pi / 2)
            cr.close_path()
            cr.set_source_rgb(0.153, 0.153, 0.165)  # #27272a
            cr.fill()

            # Active progress portion
            frac = max(0.01, min(1.0, self.current_fraction))
            prog_w = max(height, width * frac)

            cr.save()
            cr.arc(r, r, r, math.pi / 2, 3 * math.pi / 2)
            cr.arc(prog_w - r, r, r, -math.pi / 2, math.pi / 2)
            cr.close_path()
            cr.clip()

            # Premium blue gradient (#2563eb to #3b82f6)
            pat = cairo.LinearGradient(0, 0, prog_w, 0)
            pat.add_color_stop_rgb(0.0, 0.145, 0.388, 0.921)  # #2563eb
            pat.add_color_stop_rgb(1.0, 0.231, 0.510, 0.965)  # #3b82f6
            cr.set_source(pat)
            cr.paint()

            # Specular light highlight sweeping across completed progress
            shimmer_x = prog_w * self.shimmer_offset
            shimmer_w = min(80.0, max(24.0, prog_w * 0.5))
            spat = cairo.LinearGradient(shimmer_x - shimmer_w, 0, shimmer_x + shimmer_w, 0)
            spat.add_color_stop_rgba(0.0, 1.0, 1.0, 1.0, 0.0)
            spat.add_color_stop_rgba(0.5, 1.0, 1.0, 1.0, 0.35)
            spat.add_color_stop_rgba(1.0, 1.0, 1.0, 1.0, 0.0)
            cr.set_source(spat)
            cr.paint()

            cr.restore()

    def open_release_notes(_btn, tag=None):
        if shutil.which("xdg-open"):
            target_url = DEFAULT_REPO_URL
            if tag and isinstance(tag, str):
                clean_t = tag.strip()
                if re.match(r"^open-design-v\d+\.\d+\.\d+", clean_t):
                    target_url = f"{DEFAULT_REPO_URL}/tag/{clean_t}"
                elif re.match(r"^v?\d+\.\d+\.\d+$", clean_t):
                    target_url = f"{DEFAULT_REPO_URL}/tag/open-design-v{clean_t.lstrip('v')}"
            try:
                subprocess.Popen(
                    ["xdg-open", target_url],
                    start_new_session=True,
                    stdout=subprocess.DEVNULL,
                    stderr=subprocess.DEVNULL,
                )
            except OSError:
                pass

